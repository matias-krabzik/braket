# El proyecto Xcode es generado por scripts/generate_project.py: ante un
# conflicto no se fusiona, se regenera.
*.pbxproj   -merge
*.xcscheme  -merge

*.swift     text eol=lf
*.md        text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.json      text eol=lf
*.plist     text eol=lf

# Los parches del vendoring (S7) se guardan byte a byte.
*.patch     -text
